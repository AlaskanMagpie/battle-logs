{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/audio/:path*",
      "headers": [{ "key": "Content-Disposition", "value": "inline" }]
    },
    {
      "source": "/assets/intro/:path*",
      "headers": [{ "key": "Content-Disposition", "value": "inline" }]
    }
  ]
}
